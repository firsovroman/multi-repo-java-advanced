{
  "mappings": [
    {
      "name": "by-email: пользователь найден",
      "request": {
        "method": "GET",
        "urlPath": "/api/v1/persons/by-email",
        "queryParameters": {
          "email": { "matches": ".+@.+" }
        }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "userId": "3d6f3532-8b97-4c7b-8a2a-608b6aeb3a7e",
          "email": "{{request.query.email}}",
          "firstName": "Ivan",
          "lastName": "Ivanov",
          "filled": false,
          "createdAt": "{{now}}"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "by userUid: пользователь найден",
      "request": {
        "method": "GET",
        "urlPathPattern": "/api/v1/persons/[0-9a-fA-F-]{36}"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "userId": "{{request.path.[3]}}",
          "email": "user@example.com",
          "firstName": "Ivan",
          "lastName": "Ivanov",
          "filled": false,
          "createdAt": "{{now}}"
        },
        "transformers": ["response-template"]
      }
    }
  ]
}
