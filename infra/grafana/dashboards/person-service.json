{
  "uid": "person-service",
  "title": "person-service",
  "tags": ["payment-platform", "person"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Создано пользователей",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(person_users_creations_total{application=\"person-service\"}) or vector(0)", "legendFormat": "создано" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Изменено",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(person_users_updated_total{application=\"person-service\"}) or vector(0)", "legendFormat": "изменено" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Удалено",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(person_users_deleted_total{application=\"person-service\"}) or vector(0)", "legendFormat": "удалено" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Конфликты email",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(person_users_email_conflicts_total{application=\"person-service\"}) or vector(0)", "legendFormat": "конфликты" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP-запросы по статусам, в секунду",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"person-service\", uri!~\"/actuator.*\"}[5m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Длительность HTTP-запросов",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"person-service\", uri!~\"/actuator.*\"}[5m])))", "legendFormat": "p95" },
        { "refId": "B", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"person-service\", uri!~\"/actuator.*\"}[5m])))", "legendFormat": "p50" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Операции сервиса, в секунду",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (operation, outcome) (rate(person_users_operation_seconds_count{application=\"person-service\"}[5m]))", "legendFormat": "{{operation}} {{outcome}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Длительность операций, p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(person_users_operation_seconds_bucket{application=\"person-service\"}[5m])))", "legendFormat": "{{operation}}" }
      ]
    }
  ]
}
